<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.6.xsd">

    <changeSet id="create-customer-login-result-table" author="me">
        <createTable tableName="customer_login_result">
            <column name="customer_login_result_id" type="UUID">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="customer_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="username" type="VARCHAR(255)">
                <constraints nullable="false"/>
            </column>

            <column name="client_type" type="VARCHAR(50)">
                <constraints nullable="false"/>
            </column>

            <column name="timestamp" type="TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="message_id" type="UUID">
                <constraints nullable="false"/>
            </column>

            <column name="customer_ip" type="VARCHAR(39)">
                <constraints nullable="false"/>
            </column>

            <column name="login_successful" type="BOOLEAN">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

</databaseChangeLog>